# Copy to .env and change what you need. Every value here is the default.

# Ports exposed on your machine
RAG_PORT=8003
QDRANT_PORT=6333
QDRANT_VERSION=latest

# Vector DB (change the URL / add a key to use Qdrant Cloud)
QDRANT_URL=http://vector-db:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=esc_guidelines

# Embedding model (HuggingFace id). If you change it, rebuild the image AND
# use a new QDRANT_COLLECTION (vector size differs between models).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking (in words) and number of passages returned by /search
CHUNK_SIZE=200
CHUNK_OVERLAP=40
TOP_K=4
